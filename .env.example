# Copy to .env and fill in what you need. .env is gitignored.
#
#   cp .env.example .env

# --- Models ---------------------------------------------------------------
# One key gets you many models through OpenRouter; see openrouter.ai/models.
# Catalogue a model in src/llmsearchbench/providers/registry.py before running
# it — including its price, which is what the published cost column uses.
OPENROUTER_API_KEY=

# First-party Anthropic. Only needed for the `claude-*` ids (no slash).
ANTHROPIC_API_KEY=

# --- Search ---------------------------------------------------------------
# The tool the model is given. Every model in a release must use the same one,
# or the run is not comparable. Pick one and set its key:
#
#   tavily   app.tavily.com          generous free tier, cleanest snippets
#   brave    brave.com/search/api    free tier, independent index
#   serper   serper.dev              Google results, cheapest per call
#
# Then: llmsearchbench run --model <id> --backend tavily
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
