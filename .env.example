# Provider credentials. One per provider you evaluate; see
# `src/llmsearchbench/providers.py` for the catalogue.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Base URL for a locally served model, e.g. llama.cpp or vLLM.
LOCAL_MODEL_BASE_URL=

# Search backend. Every model in a release must use the same one,
# or the run is not comparable.
SEARCH_BACKEND=
SEARCH_API_KEY=
