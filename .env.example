# Copy to .env and add one model key. .env is gitignored.
#
#   cp .env.example .env

# One key, many models. See openrouter.ai/models.
# Catalogue a model in src/llmsearchbench/providers/registry.py before running
# it, including its price — that is what the cost figures use.
OPENROUTER_API_KEY=

# First-party Anthropic. Only needed for the `claude-*` ids (no slash).
ANTHROPIC_API_KEY=
